  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RadioSubtitles
  panelGroup: {fileID: 1192455833}
  subtitleText: {fileID: 1478667616}
  fadeSpeed: 4
  displayTime: 5
  lineIntro: "\u0421\u0440\u043E\u0447\u043D\u043E \u0432\u044B\u0431\u0438\u0440\u0430\u0439\u0441\u044F!
    \u0421\u043A\u043E\u0440\u043E \u043F\u0440\u0438\u0435\u0434\u0435\u0442 \u041D\u041A\u0412\u0414.\n\u0410
    \u043F\u043E\u043A\u0430 \u2014 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438
    \u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440."
  lineFindDoor: "\u041E\u0442\u043A\u0440\u043E\u0439 \u0434\u0432\u0435\u0440\u044C
    \u0438 \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u044B\u0431\u0438\u0440\u0430\u0439\u0441\u044F
    \u043E\u0442\u0441\u044E\u0434\u0430!"
  lineTurnOff: "\u0412\u044B\u043A\u043B\u044E\u0447\u0438 \u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440
    \u2014 \u0438 \u0434\u0432\u0435\u0440\u044C \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F."
  lineWin: "\u0411\u0435\u0433\u0438!"
